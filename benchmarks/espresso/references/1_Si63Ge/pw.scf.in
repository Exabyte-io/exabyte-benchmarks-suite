&control
    calculation  = 'scf'
    restart_mode = 'from_scratch'
    pseudo_dir   = './'
    outdir       = './outdir/'
    prefix       = 'scf_'
    disk_io      = 'none'
    wf_collect   = .false.
    tstress      = true
    tprnfor      = true
/

&system
    ibrav       = 0
    celldm(1)   = 1
    ecutwfc     = 50
    ecutrho     = 800
    occupations = 'smearing'
    smearing    = 'gauss'
    degauss     = 0.01
    nat         = 64
    ntyp        = 2
    nbnd        = 800
/
&electrons
    conv_thr         = 1.0d-11
    mixing_beta      = 0.7
    electron_maxstep = 100
/

ATOMIC_SPECIES
Ge 0.0 ge_pbe_v1.4.uspp.F.UPF
Si 0.0 si_pbe_v1.uspp.F.UPF

